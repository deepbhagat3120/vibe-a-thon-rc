# RealityCheck Environment Configuration
# Copy this file to .env and supply your credentials if using a live LLM or Synapse cloud features

# LLM Provider Configuration (Optional - RealityCheck includes built-in mock orchestrator for offline demo)
# Supported options: openai | anthropic | groq | gemini | local
LLM_PROVIDER=mock
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=

# Synapse CLI Settings
SYNAPSE_API_KEY=
SYNAPSE_PROJECT_ID=
SYNAPSE_PORT=8000
SYNAPSE_MODE=custom

# RealityCheck Settings
DEBUG=True
DATA_PATH=data/products.json
